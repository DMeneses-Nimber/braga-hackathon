# Copiar para .env e ajustar. O .env fica fora do Git.

# Porta da API; o Vite reencaminha /api para aqui
PORT=3000

# Pasta dos dados, relativa à pasta api/
DATA_DIR=../data

# --- Agentes ---
# Sem a chave do Grok os agentes ficam desligados e a verificação devolve 501.
# Chave em https://console.x.ai/
XAI_API_KEY=

# Modelo de cada agente (por omissão grok-4.7)
GROK_MODEL_RECOLHA=
GROK_MODEL_COMPARACAO=

# Opcional. Google Maps (Places API New): morada, website e estado.
# Precisa de faturação ativa num projeto Google Cloud.
GOOGLE_MAPS_API_KEY=

# Opcional. Tavily: pesquisa web restrita a LinkedIn, redes sociais e Teamlyzer.
# O plano gratuito dá 1000 pesquisas por mês: https://app.tavily.com
TAVILY_API_KEY=

# 1 para usar só as respostas guardadas em data/cache/ (demonstração sem internet)
MODO_OFFLINE=

# Máximo de passos do agente de recolha numa verificação (4 a 40)
AGENT_MAX_STEPS=16
